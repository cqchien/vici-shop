{
  "name": "auth-service",
  "version": "0.0.0",
  "private": true,
  "description": "Identity bounded context — accounts, credentials, tokens, OTP. TypeScript/NestJS (ADR-011), plain CRUD hexagonal. Fully self-contained: every config lives in this folder.",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:all": "jest --runInBand",
    "typeorm": "typeorm-ts-node-commonjs -d src/infrastructure/persistence/migrations.datasource.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "typeorm-ts-node-commonjs -d src/infrastructure/persistence/migrations.datasource.ts migration:generate"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/typeorm": "10.0.2",
    "@node-rs/argon2": "2.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "date-fns": "4.4.0",
    "dotenv": "16.4.5",
    "helmet": "8.0.0",
    "nestjs-cls": "4.4.1",
    "nestjs-pino": "4.1.0",
    "pg": "8.13.1",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "typeorm-naming-strategies": "4.1.0",
    "uuid": "11.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@testcontainers/postgresql": "10.13.2",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/node": "22.9.0",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.3.3",
    "supertest": "7.0.0",
    "testcontainers": "10.13.2",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.5.4"
  }
}
