# auth-service — sao chép thành .env (git-ignored). Chỉ giá trị placeholder ở đây.

# HTTP + gRPC
PORT=3001
GRPC_PORT=50051

# Database — app role KHÔNG có BYPASSRLS (tenant plane, ADR-007)
DATABASE_URL=postgres://vici:vici@localhost:5432/auth_db

# Redis — đếm login attempt (FR-AUTH-05)
REDIS_URL=redis://localhost:6379

# Kafka — publish auth.*
KAFKA_BROKERS=localhost:9092

# JWT — RS256; public key share cho Kong JWT plugin
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...placeholder...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...placeholder...\n-----END PUBLIC KEY-----
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
IMPERSONATION_TTL_MIN=30

# Login lockout (FR-AUTH-05)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# OAuth Google (FR-AUTH-04) — từ secret manager ở môi trường thật
GOOGLE_OAUTH_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=placeholder

# Downstream gRPC
USER_GRPC_URL=user-service:50052

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=auth-service
