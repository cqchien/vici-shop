NODE_ENV=development
PORT=3001

# JSON always; pino-pretty only when NODE_ENV=development. Empty → debug in dev / info otherwise.
LOG_LEVEL=

# ─── Postgres ────────────────────────────────────────────────
DATABASE_URL=postgresql://vici_app:vici_local_password@localhost:5432/auth_db

# ─── Gateway lockdown (ADR-012) ───────────────────────────────
# Only requests carrying this header are served (GatewayOnlyGuard) — Kong stamps it on every
# proxied request. Must match the central stack's GATEWAY_SHARED_SECRET when running through it;
# for a bare `pnpm start:dev` you call yourself, set any value and send it as X-Gateway-Secret.
GATEWAY_SHARED_SECRET=dev_only_gateway_secret_change_me

# ─── OTP ──────────────────────────────────────
OTP_TTL_MINUTES=15

# ─── Password hashing (argon2id) ─────────────────────────────
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
