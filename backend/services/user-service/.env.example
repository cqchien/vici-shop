# user-service — sao chép thành .env (git-ignored). Chỉ giá trị placeholder ở đây.

# HTTP + gRPC
PORT=3002
GRPC_PORT=50052

# Database — app role KHÔNG có BYPASSRLS (tenant plane, ADR-007)
DATABASE_URL=postgres://vici:vici@localhost:5432/user_db

# Kafka — publish customer.*, consume auth.account_registered / order.* / tenant.provisioned
KAFKA_BROKERS=localhost:9092

# Downstream gRPC
AUTH_GRPC_URL=auth-service:50051
ORDER_GRPC_URL=order-service:50056

# Loyalty (mặc định — có thể override theo tenant qua settings)
POINT_EARN_RATE_VND=10000
POINT_VALUE_VND=100
MAX_POINT_REDEEM_PERCENT=50
TIER_THRESHOLDS_VND=5000000,12000000,20000000
TIER_MULTIPLIERS=1,1.2,1.5,2
POINTS_EXPIRY_MONTHS=12

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=user-service
