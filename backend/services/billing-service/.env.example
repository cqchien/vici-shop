# billing-service — sao chép thành .env (git-ignored). Chỉ giá trị placeholder ở đây.

# HTTP + gRPC
PORT=3013
GRPC_PORT=50062

# Database — role CROSS-TENANT (platform plane)
DATABASE_URL=postgres://vici:vici@localhost:5432/billing_db

# Kafka — publish billing.*, consume usage events (product.*, order.placed, tenant.*)
KAFKA_BROKERS=localhost:9092

# Nhà cung cấp thanh toán định kỳ (sandbox trước)
PAYMENT_PROVIDER=stripe-sandbox
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_from_secret_manager

# Nghiệp vụ
DUNNING_SCHEDULE_DAYS=1,3,5
ENTITLEMENTS_CACHE_TTL_S=45

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=billing-service
