# tenant-service — sao chép thành .env (git-ignored). Chỉ giá trị placeholder ở đây.

# HTTP + gRPC
PORT=3012
GRPC_PORT=50061

# Database — role CROSS-TENANT (platform plane, không set app.tenant_id)
DATABASE_URL=postgres://vici:vici@localhost:5432/tenant_db

# Kafka — publish tenant.*, consume billing.*
KAFKA_BROKERS=localhost:9092

# Downstream gRPC
AUTH_GRPC_URL=auth-service:50051
BILLING_GRPC_URL=billing-service:50062

# Kong Admin API — đăng ký route subdomain khi provisioning
KONG_ADMIN_URL=http://kong:8001

# Domain
ROOT_DOMAIN=vici.shop
PROVISIONING_TIMEOUT_MS=300000
IMPERSONATION_TTL_MIN=30

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=tenant-service
