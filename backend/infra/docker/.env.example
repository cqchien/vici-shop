# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=vici
POSTGRES_PASSWORD=vici_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Separate databases per service (ADR-001). Business DBs use a role WITHOUT bypassrls (ADR-007);
# tenant_db / billing_db (platform plane) use a cross-tenant role.
TENANT_DB_URL=postgresql://vici:vici_local_password@postgres:5432/tenant_db
BILLING_DB_URL=postgresql://vici:vici_local_password@postgres:5432/billing_db
AUTH_DB_URL=postgresql://vici:vici_local_password@postgres:5432/auth_db
USER_DB_URL=postgresql://vici:vici_local_password@postgres:5432/user_db
PRODUCT_DB_URL=postgresql://vici:vici_local_password@postgres:5432/product_db
INVENTORY_DB_URL=postgresql://vici:vici_local_password@postgres:5432/inventory_db
ORDER_DB_URL=postgresql://vici:vici_local_password@postgres:5432/order_db
PAYMENT_DB_URL=postgresql://vici:vici_local_password@postgres:5432/payment_db
SHIPPING_DB_URL=postgresql://vici:vici_local_password@postgres:5432/shipping_db
PROMOTION_DB_URL=postgresql://vici:vici_local_password@postgres:5432/promotion_db
FINANCE_DB_URL=postgresql://vici:vici_local_password@postgres:5432/finance_db
NOTIFICATION_DB_URL=postgresql://vici:vici_local_password@postgres:5432/notification_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ─── JWT ──────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_ACCESS_EXPIRY=900         # 15 phút (giây)
JWT_REFRESH_EXPIRY=2592000    # 30 ngày (giây)

# ─── Payment gateways (sandbox) ───────────────────────────────
VNPAY_TMN_CODE=...
VNPAY_HASH_SECRET=...
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=...
MOMO_ACCESS_KEY=...
MOMO_SECRET_KEY=...
ZALOPAY_APP_ID=...
ZALOPAY_KEY1=...
ZALOPAY_KEY2=...

# ─── Shipping carriers (sandbox) ──────────────────────────────
GHN_TOKEN=...
GHN_SHOP_ID=...
GHTK_TOKEN=...

# ─── Email (notification) ─────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@vici-shop.local

# ─── Tenancy / Billing (platform plane) ──────────────────────
ROOT_DOMAIN=vici.shop
KONG_ADMIN_URL=http://kong:8001
PROVISIONING_TIMEOUT_MS=300000
IMPERSONATION_TTL_MIN=30
PAYMENT_PROVIDER=stripe-sandbox
PAYMENT_WEBHOOK_SECRET=whsec_placeholder_from_secret_manager
DUNNING_SCHEDULE_DAYS=1,3,5

# ─── OpenTelemetry ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_VERSION=local
